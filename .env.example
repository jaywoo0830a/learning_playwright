# ─────────────────────────────────────────────────────────────
# .env.example — 서버 주소 설정 템플릿
#
# 이 파일을 복사해서 .env 로 저장하고 값을 수정하세요:
#   cp .env.example .env
#
# test.sh 와 conftest.py 가 .env 를 자동으로 읽습니다.
# .env 파일이 없으면 아래 기본값이 사용됩니다.
# ─────────────────────────────────────────────────────────────

# 서버 호스트 (기본: 127.0.0.1)
HOST=127.0.0.1

# 기준 포트 (기본: 8100)
# 실제 포트 = BASE_PORT + 문제번호
#   문제 1 → 8101
#   문제 2 → 8102
#   ...
#   문제 10 → 8110
BASE_PORT=8100
